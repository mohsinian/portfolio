---
import { cv, cvIsConfigured } from "../config/site";
---

<section class="min-h-screen flex items-center justify-center pt-20 px-6">
  <div class="max-w-5xl w-full flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1 text-center md:text-left">
      <p class="text-accent font-medium text-sm tracking-widest uppercase mb-3">Software Engineer</p>
      <h1 class="text-4xl md:text-6xl font-bold text-[var(--color-primary)] leading-tight mb-6">
        Tahsin Ahmed<br />Majumder
      </h1>
      <p class="lit-text text-[var(--color-text-light)] text-lg max-w-lg mb-8 leading-relaxed">
        Building scalable backend systems for European public transportation.
        Experienced with Node.js, Go, Python, and cloud-native architectures.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a
          href="#experience"
          class="px-6 py-3 bg-accent text-white rounded-lg hover:bg-accent-light transition-colors text-sm font-medium text-center"
        >
          View Experience
        </a>
        <a
          href="#projects"
          class="px-6 py-3 border border-[var(--color-card-border)] text-[var(--color-primary)] rounded-lg hover:border-accent hover:text-accent transition-colors text-sm font-medium text-center"
        >
          See Projects
        </a>
        {cvIsConfigured && (
          <a
            href={cv.download}
            target="_blank"
            rel="noopener noreferrer"
            download={cv.mode === "local" ? "Tahsin_Ahmed_Majumder_CV.pdf" : true}
            class="px-6 py-3 border border-[var(--color-card-border)] text-[var(--color-primary)] rounded-lg hover:border-accent hover:text-accent transition-colors text-sm font-medium text-center inline-flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download CV
          </a>
        )}
      </div>
    </div>
    <div class="flex-shrink-0">
      <div class="w-64 h-64 md:w-80 md:h-80 rounded-full overflow-hidden shadow-2xl shadow-accent/10 ring-1 ring-[var(--color-card-border)]">
        <img
          src="/profile.webp"
          alt="Tahsin Ahmed Majumder"
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
