---
const skillCategories = [
  {
    title: "Languages",
    skills: ["TypeScript", "Node.js", "Python", "Golang", "SQL", "C++", "Ruby", "ColdFusion", "HTML/CSS"],
  },
  {
    title: "Frameworks & Databases",
    skills: ["FastAPI", "NestJS", "Express", "Flask", "Pydantic", "Zod", "Rails", "ColdBox", "PostgreSQL", "Supabase", "MySQL", "MariaDB", "MongoDB"],
  },
  {
    title: "Developer Tools",
    skills: ["Git", "GitHub", "Docker", "Linux", "Bash", "NPM", "Vitest", "CI pipelines", "Postman", "VS Code"],
  },
  {
    title: "Data & ML",
    skills: ["pandas", "NumPy", "scikit-learn", "XGBoost", "Transformers", "spaCy", "MQTT", "ETL pipelines"],
  },
];
---

<section id="skills" class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-2xl font-bold text-[var(--color-primary)] mb-12">Technical Skills</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {skillCategories.map((cat) => (
        <div class="machine-panel p-6">
          <h3 class="text-sm font-semibold text-accent uppercase tracking-wider mb-4">
            {cat.title}
          </h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="px-3 py-1.5 bg-[var(--color-surface)] text-[var(--color-text)] text-sm rounded-lg border border-[var(--color-card-border)] hover:bg-accent/10 hover:border-accent/40 hover:text-accent transition-colors cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
