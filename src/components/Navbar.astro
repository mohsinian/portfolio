---
import { cv, cvIsConfigured } from "../config/site";

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Education", href: "#education" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg)]/80 backdrop-blur-md border-b border-[var(--color-border)]">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="#" class="text-lg font-bold text-[var(--color-primary)] tracking-tight">
        TAM<span class="text-accent">.</span>
      </a>
      <button id="mode-toggle" aria-label="Open terminal mode" aria-pressed="false" class="mode-toggle flex items-center gap-2 h-8 px-2.5 rounded-md border border-[var(--color-card-border)] font-mono text-xs text-[var(--color-text-light)] hover:text-accent hover:border-accent/60 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" />
        </svg>
        <span id="mode-toggle-label">Terminal</span>
      </button>
    </div>
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-command={link.label === "About" ? "whoistahsin" : link.label === "Skills" ? "skills --matrix" : link.label === "Experience" ? "cat experience.log" : link.label === "Projects" ? "ls projects" : "education"}
          class="text-sm text-[var(--color-text-light)] hover:text-accent transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      {cvIsConfigured && (
        <a
          href={cv.view}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm px-4 py-2 border border-accent text-accent rounded-lg hover:bg-accent hover:text-white transition-colors duration-200"
        >
          CV
        </a>
      )}
      <a
        href="mailto:tahsinbd.ahmed1@gmail.com"
        class="text-sm px-4 py-2 bg-accent text-white rounded-lg hover:bg-accent-light transition-colors duration-200"
      >
        Contact
      </a>
    </div>
    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="md:hidden text-[var(--color-primary)]" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden px-6 pb-4 space-y-3">
    {navLinks.map((link) => (
      <a href={link.href} data-command={link.label === "About" ? "whoistahsin" : link.label === "Skills" ? "skills --matrix" : link.label === "Experience" ? "cat experience.log" : link.label === "Projects" ? "ls projects" : "education"} class="block text-sm text-[var(--color-text-light)] hover:text-accent transition-colors">
        {link.label}
      </a>
    ))}
    {cvIsConfigured && (
      <a
        href={cv.view}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-sm px-4 py-2 border border-accent text-accent rounded-lg text-center hover:bg-accent hover:text-white transition-colors"
      >
        CV
      </a>
    )}
    <a
      href="mailto:tahsinbd.ahmed1@gmail.com"
      class="block text-sm px-4 py-2 bg-accent text-white rounded-lg text-center hover:bg-accent-light transition-colors"
    >
      Contact
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById("mode-toggle");
  const label = document.getElementById("mode-toggle-label");
  const html = document.documentElement;

  function applyMode(mode: "gui" | "terminal") {
    html.dataset.mode = mode;
    const terminal = mode === "terminal";
    toggle?.setAttribute("aria-pressed", String(terminal));
    toggle?.setAttribute("aria-label", terminal ? "Return to portfolio mode" : "Open terminal mode");
    if (label) label.textContent = terminal ? "Portfolio" : "Terminal";
    window.dispatchEvent(new CustomEvent("portfolio-mode-change", { detail: { mode } }));
  }

  function syncModeControls(mode: "gui" | "terminal") {
    const terminal = mode === "terminal";
    toggle?.setAttribute("aria-pressed", String(terminal));
    toggle?.setAttribute("aria-label", terminal ? "Return to portfolio mode" : "Open terminal mode");
    if (label) label.textContent = terminal ? "Portfolio" : "Terminal";
  }

  applyMode(html.dataset.mode === "terminal" ? "terminal" : "gui");

  toggle?.addEventListener("click", () => {
    const mode = html.dataset.mode === "terminal" ? "gui" : "terminal";
    applyMode(mode);
    localStorage.setItem("mode", mode);
    localStorage.removeItem("theme");
  });

  window.addEventListener("portfolio-mode-change", ((event: CustomEvent<{ mode: "gui" | "terminal" }>) => {
    syncModeControls(event.detail.mode);
  }) as EventListener);

  // Mobile menu
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu?.classList.add("hidden"))
  );
</script>
